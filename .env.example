# .env.example  (teammates copy this to .env and fill in)
DATABASE_URL=sqlite:///./roadguard.db
SECRET_KEY=super-secret-key-for-jwt-needs-32-chars-minimum

# ----- DEV BASED ----- 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASSWORD=your-app-password
OCR_BACKEND=stub
TRAINED_OCR_PATH=./models/plate_ocr.onnx

# ----- Email Delivery -----
# Mailtrap (sandbox testing - emails appear in Mailtrap web inbox)
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_FROM=noreply@roadguard.ph

# Resend (live delivery to real inboxes)
RESEND_API_KEY=
RESEND_FROM=noreply@roadguard.ph